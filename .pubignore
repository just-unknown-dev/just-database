# pub ignores .gitignore when this file exists, so everything that must
# not be published is listed here.

# IDE and editor files
.idea/
.vscode/
*.iml

# Build and tool output (anchored: extension/devtools/build/ is published)
.dart_tool/
/build/
coverage/
doc/api/
.flutter-plugins
.flutter-plugins-dependencies
example/build/
example/.dart_tool/

# Repository files
.git/
.github/
.gitignore
.gitattributes
.metadata

# Local development
pubspec.lock
pubspec_overrides.yaml
example/pubspec.lock
example/pubspec_overrides.yaml
/devtools_options.yaml
example/devtools_options.yaml

# Temporary files
*.tmp
*.log
.DS_Store
Thumbs.db

# Audit notes (not part of the package)
.audit/

# The DevTools extension's source; its build in extension/devtools/build/
# is published (build it first: devtools_extension/README.md)
devtools_extension/
